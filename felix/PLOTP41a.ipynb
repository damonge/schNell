         "source": [
            "C_AET = np.array([\n",
            "    [-1/np.sqrt(2),  0.0,          1/np.sqrt(2)],   # A\n",
            "    [ 1/np.sqrt(6), -2/np.sqrt(6), 1/np.sqrt(6)],   # E\n",
            "    [ 1/np.sqrt(3),  1/np.sqrt(3), 1/np.sqrt(3)],   # T  Dit is Eq. 4.25, de andere verglijkingen werkte niet. Dus we doen het via DeltaF\n",
            "    ], dtype=float)\n",
            "\n",
            "OIDX = {\"A\": 0, \"E\": 1, \"T\": 2}\n",
            "\n",
            "\n",
            "def Rlm_OOp_from_rlmij(rlm_ij_mge0, ell, m, O, Op):\n",
            "    cO  = C_AET[OIDX[O]]\n",
            "    cOp = C_AET[OIDX[Op]]\n",
            "    return np.sum(cO[:, None] * cOp[None, :] * rlm_ij_mge0) # dit is eq. 4.27 in de paper\n",
            "\n",
            "\n",
            "def Rell_OOp_from_rlmij_list(rlm_ij_list_mge0, ell, O, Op): # Dit is eq. 4.28 in de paper, maar dan geschreven als een andere som, want je\n",
            "    z0 = Rlm_OOp_from_rlmij(rlm_ij_list_mge0[0], ell, 0, O, Op) # kan die som op deze manier schrijven (zie bald papier felix groene notas) \n",
            "    s = np.abs(z0)**2\n",
            "    for m in range(1, ell + 1):\n",
            "        zm = Rlm_OOp_from_rlmij(rlm_ij_list_mge0[m], ell, m, O, Op)\n",
            "        s += 2.0 * np.abs(zm)**2\n",
            "    return np.sqrt(s)"
         ]
      },
