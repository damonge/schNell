         "source": [
            "#constanten enzo\n",
            "\n",
            "C_LIGHT = 299_792_458.0\n",
            "L_ARM   = 2.5e9\n",
            "F_STAR  = C_LIGHT / (2.0 * np.pi * L_ARM)\n",
            "\n",
            "MPC_M     = 3.0856775814913673e22\n",
            "H0_OVER_h = (100.0 * 1000.0) / MPC_M  \n",
            "\n",
            "P_OMS_PM = 15.0  \n",
            "A_ACC_FM = 3.0  "
         ]
      },
      {
         "cell_type": "code",
         "execution_count": 3,
